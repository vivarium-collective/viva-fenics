.pixi/
.venv/
__pycache__/
*.egg-info/
dist/
build/
*.pyc
.pytest_cache/
output/
*.nc
reports/published/
scratch/*.png

# .pbg/ is runtime state — ignore all of it EXCEPT the vendored schemas
# (lint-workspace.py validates against .pbg/schemas/*.json, so they must be
# committed) and the example env file. A blanket `.pbg/` here would override
# the re-includes below and drop the schemas from CI (workspace-ci lint fails).
.pbg/*
!.pbg/schemas/
!.pbg/hpc.env.example
investigations/*/runs.db
investigations/*/viz/
investigations/*/.run.lock
workspace/reports/assets/*
!workspace/reports/assets/.keep
.superpowers/brainstorm/
